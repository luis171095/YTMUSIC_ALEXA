# ───────────────────────────────────────────────────────────────────────
#  Variables de entorno de la función Lambda
#  Configúralas en: AWS Console → Lambda → Configuration → Environment
#  variables.  NO subas tus valores reales a GitHub: este archivo es solo
#  una plantilla de referencia.
# ───────────────────────────────────────────────────────────────────────

# (OBLIGATORIA) Clave de la YouTube Data API v3. Se usa para BUSCAR videos.
#   Consíguela en https://console.cloud.google.com → APIs → "YouTube Data API v3".
DEVELOPER_KEY=tu_youtube_data_api_key

# (RECOMENDADA) Proxy datacenter para esquivar el bloqueo de IP de AWS al
#   EXTRAER el stream con yt-dlp. Ej. un proxy gratuito de Webshare.
#   Formato: http://usuario:password@host:puerto
proxy=http://usuario:password@host:puerto
proxy_enabled=true

# (OPCIONAL) Clientes InnerTube de yt-dlp, en orden de preferencia.
#   'android_vr' va primero: devuelve URLs SIN candado PO-token/SABR, así el
#   audio se reproduce COMPLETO (no se corta a ~2 min). No cambiar salvo que
#   sepas lo que haces.
player_clients=android_vr,ios,android,tv,mweb,web

# (OPCIONAL) ID de tu canal de YouTube para "reproduce mi último video".
MY_CHANNEL_ID=

# (OPCIONAL) Motor de extracción: youtube_dl (por defecto) | pytube | youtubestream | rapidapi
# get_url_service=youtube_dl

# (OPCIONAL) Fecha de expiración de la skill en formato YYYYMMDD.
# expires=20991231
